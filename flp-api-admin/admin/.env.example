# Copy to .env and fill in. Only VITE_* values reach the browser — never put secrets here.
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: development-only login that skips Supabase, to look at the UI before a project exists.
# Put these in .env.development.local (git-ignored, and never loaded by production builds).
# VITE_DEV_AUTH=true
# VITE_DEV_ADMIN_EMAIL=
# VITE_DEV_ADMIN_PASSWORD=
