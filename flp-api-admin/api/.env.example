# Copy to .env and fill in. Never commit .env.

# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Supabase (Project Settings → API / Database), project in ap-south-1 ---
# Pooler connection string, transaction mode (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Server only. Never put this in the mobile app or admin panel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tests (local Postgres 17) ---
TEST_DATABASE_URL=postgresql://localhost:5432/flp_test

# --- Bunny (Phase 2) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_STREAM_CDN_HOST=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_REGION=
BUNNY_PULL_ZONE_HOST=
BUNNY_PULL_ZONE_TOKEN_KEY=

# --- Razorpay (Phase 2) — test keys in development ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Zoom (Phase 3) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# --- Firebase Cloud Messaging (Phase 3) ---
FIREBASE_SERVICE_ACCOUNT_JSON=
