# Copy to .env and fill in. Only public values go here — they are compiled into the app.

# FLP API. The Android emulator reaches your Mac's localhost at 10.0.2.2.
API_URL=http://10.0.2.2:4000

# Supabase project (Project Settings → API). The anon key is public; never put the service role key here.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Optional: development-only student login that skips the Supabase SMS, to look at the UI before a
# project exists. Any 6-digit code is accepted for this number. Never active in release builds.
# DEV_AUTH=true
# DEV_STUDENT_PHONE=
